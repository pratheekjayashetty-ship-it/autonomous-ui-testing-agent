{
  "summary": "Test SauceDemo login and shopping cart functionality",
  "scenarios": [
    {
      "id": "TC1",
      "criterion": "Valid login with standard_user and secret_sauce should display Products page",
      "steps": [
        {
          "action": "fill",
          "target": "Username",
          "value": "standard_user"
        },
        {
          "action": "fill",
          "target": "Password",
          "value": "secret_sauce"
        },
        {
          "action": "click",
          "target": "Login",
          "value": null
        }
      ],
      "verification": {
        "kind": "visible_text",
        "expected": "Products"
      }
    },
    {
      "id": "TC2",
      "criterion": "Add Sauce Labs Backpack to cart after valid login; cart count becomes 1",
      "steps": [
        {
          "action": "fill",
          "target": "Username",
          "value": "standard_user"
        },
        {
          "action": "fill",
          "target": "Password",
          "value": "secret_sauce"
        },
        {
          "action": "click",
          "target": "Login",
          "value": null
        },
        {
          "action": "click",
          "target": "Sauce Labs Backpack | Add to cart",
          "value": null
        }
      ],
      "verification": {
        "kind": "visible_text",
        "expected": "1"
      }
    },
    {
      "id": "TC3",
      "criterion": "After adding Sauce Labs Backpack to cart, opening cart displays the product",
      "steps": [
        {
          "action": "fill",
          "target": "Username",
          "value": "standard_user"
        },
        {
          "action": "fill",
          "target": "Password",
          "value": "secret_sauce"
        },
        {
          "action": "click",
          "target": "Login",
          "value": null
        },
        {
          "action": "click",
          "target": "Sauce Labs Backpack | Add to cart",
          "value": null
        },
        {
          "action": "click",
          "target": "Cart",
          "value": null
        }
      ],
      "verification": {
        "kind": "visible_text",
        "expected": "Sauce Labs Backpack"
      }
    },
    {
      "id": "TC4",
      "criterion": "Problem user can add Sauce Labs Bolt T-Shirt to cart; button changes to Remove",
      "steps": [
        {
          "action": "fill",
          "target": "Username",
          "value": "problem_user"
        },
        {
          "action": "fill",
          "target": "Password",
          "value": "secret_sauce"
        },
        {
          "action": "click",
          "target": "Login",
          "value": null
        },
        {
          "action": "click",
          "target": "Sauce Labs Bolt T-Shirt | Add to cart",
          "value": null
        }
      ],
      "verification": {
        "kind": "visible_text",
        "expected": "Remove"
      }
    }
  ]
}